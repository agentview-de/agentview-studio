{
  "schemaVersion": 3,
  "id": "pl_offline_demo",
  "name": "Offline Demo (no agentView account required)",
  "canvas": { "w": 1920, "h": 1080, "fit": "fill" },
  "defaults": { "transition": "fade", "theme": "minimal-dark", "duration": 8 },
  "slides": [
    {
      "id": "s1",
      "duration": 7,
      "theme": "gradient-purple",
      "transition": "zoom",
      "widgets": [
        {
          "id": "w_title", "type": "text", "z": 1,
          "rect": { "x": 10, "y": 28, "w": 80, "h": 22 },
          "content": { "body": "Hi there 👋", "font": "sans", "theme": "gradient-purple" },
          "anim": { "type": "scale", "delay": 0, "duration": 650 }
        },
        {
          "id": "w_sub", "type": "text", "z": 2,
          "rect": { "x": 14, "y": 52, "w": 72, "h": 18 },
          "content": { "body": "agentView Studio running entirely offline — now with entrance builds and ambient motion.", "font": "sans", "theme": "gradient-purple" },
          "anim": { "type": "fade-up", "delay": 420, "duration": 600 }
        }
      ]
    },
    {
      "id": "s2",
      "duration": 7,
      "theme": "minimal-dark",
      "transition": "slide-up",
      "widgets": [
        {
          "id": "w_clock", "type": "clock", "z": 1,
          "rect": { "x": 20, "y": 22, "w": 60, "h": 56 },
          "content": { "timezone": "Europe/Berlin", "label": "Berlin", "display": "date-time", "style": "digital", "theme": "minimal-dark" },
          "anim": { "type": "blur", "delay": 0, "duration": 700 },
          "loop": "float"
        }
      ]
    },
    {
      "id": "s3",
      "duration": 9,
      "theme": "corporate-blue",
      "transition": "dissolve",
      "widgets": [
        {
          "id": "w_kpi", "type": "kpi-cards", "z": 1,
          "rect": { "x": 8, "y": 16, "w": 84, "h": 68 },
          "content": {
            "source": "inline",
            "theme": "corporate-blue",
            "cards": [
              { "label": "Visitors", "value": 12450, "deltaPct": 6.2, "history": "100, 110, 108, 120, 122, 124" },
              { "label": "Conv. rate", "value": 3.7, "unit": "%", "deltaPct": 0.4, "history": "3.1, 3.2, 3.4, 3.5, 3.7" }
            ]
          },
          "anim": { "type": "rise", "delay": 120, "duration": 700 }
        }
      ]
    }
  ]
}
