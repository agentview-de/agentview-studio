{
  "name": "agentview-studio",
  "version": "1.6.0",
  "description": "Visual editor + player for agentView digital signage. Zero-runtime-dependency vanilla ES modules — this manifest exists ONLY for dev tooling (lint + tests), never for shipping code.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/agentview-de/agentview-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentview-de/agentview-studio.git"
  },
  "bugs": {
    "url": "https://github.com/agentview-de/agentview-studio/issues"
  },
  "scripts": {
    "test": "node test/run-node.mjs",
    "test:browser": "node test/run-browser.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run i18n -- --quiet && npm run store && npm test",
    "i18n": "node tools/i18n-check.mjs",
    "store": "node tools/store-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=20"
  }
}
